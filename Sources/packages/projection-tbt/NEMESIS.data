[nemesis]
version=1.1
id=projection.tbt
name=Projection cluster TBT
type=application
package-version=1.0.0
short-desc="Turn-by-turn on the cluster during projection."
os="*.260507"
models="any"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
