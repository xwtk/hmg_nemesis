<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nemesis.manager"
    android:versionCode="16"
    android:versionName="1.15">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- HMG's ActivityManager checks GET_TASKS in finishActivity(); without it the
         dialog crashes when Yes is tapped (the reply is already written). -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <!-- Gates DialogActivity: usb-handler starts it as root, other apps cannot. -->
    <permission
        android:name="com.nemesis.manager.permission.DIALOG"
        android:protectionLevel="signature" />
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Hkmc"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/Hkmc"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DialogActivity"
            android:label="@string/app_name"
            android:theme="@style/Hkmc.Dialog"
            android:exported="true"
            android:permission="com.nemesis.manager.permission.DIALOG"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />
        <activity
            android:name=".OptionsActivity"
            android:theme="@style/Hkmc" />
        <activity
            android:name=".PackageActivity"
            android:theme="@style/Hkmc" />
        <activity
            android:name=".ServiceActivity"
            android:theme="@style/Hkmc" />
        <activity
            android:name=".LogActivity"
            android:theme="@style/Hkmc" />
        <receiver
            android:name=".SetupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="mobis.intent.action.SHORTCUT_SETUP" />
                <action android:name="mobis.intent.action.SHORTCUT_MODE" />
                <action android:name="mobis.intent.action.SHORTCUT_MEDIA" />
                <action android:name="mobis.intent.action.SHORTCUT_RADIO" />
