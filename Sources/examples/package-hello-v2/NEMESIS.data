[nemesis]
version=1.1
id=hello.tool
name=Hello Tool
type=application,service
package-version=2.0.0
short-desc="Example package with an app and a service (v2)."
os=any
models=any
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=sh
path=bin/tool.sh
uid=root

[service.0]
name=hello-daemon
kind=sh
path=svc/daemon.sh
uid=root
mode=background
