*/out/
NEMESIS Source/out/
NEMESIS Source/native/*.o
NEMESIS Source/porter/build/
NEMESIS Source/native/nemesis
NEMESIS Source/manager/*.apk
NEMESIS Source/manager/classes/
NEMESIS Source/manager/gen/
NEMESIS Source/manager/classes.dex
NEMESIS Source/manager/res.apk
NEMESIS Source/manager/unsigned.apk
NEMESIS Source/manager/nemesis.keystore
USB package path/installer/classes/
USB package path/installer/gen/
USB package path/installer/classes.dex
USB package path/installer/res.apk
USB package path/installer/unsigned.apk
USB package path/installer/NEMESIS-Installer.apk
USB package path/installer/nemesis.keystore
**/__pycache__/
*.pyc

# Kept out of the public tree on purpose: firmware-derived files (patched or stock head-unit
# apps and libraries), third-party binaries, unreleased packages and private dev notes.
# The Makefile and tests skip what is missing here.
NEMESIS Source/LIVEPATCH_PLAN.md
NEMESIS Source/LIVEPATCH_TODO.md
NEMESIS Source/livepatch-proto/
