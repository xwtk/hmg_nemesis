<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/co_list_selector"
    android:descendantFocusability="blocksDescendants"
    android:minHeight="84dp"
    android:gravity="center_vertical"
    android:paddingLeft="22dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/row_icon"
        android:scaleType="fitCenter"
        android:layout_marginRight="16dp"
        android:layout_width="56dp"
        android:layout_height="56dp" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/row_title"
            android:textSize="26sp"
            android:textColor="@color/list_title"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/row_summary"
                android:textSize="20sp"
                android:textColor="@color/list_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/row_count"
                android:textSize="20sp"
                android:textColor="@color/list_summary"
                android:singleLine="true"
                android:paddingLeft="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <com.nemesis.manager.SweepBar
            android:id="@+id/row_bar"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="6dp" />
    </LinearLayout>
    <Button
        android:id="@+id/row_action"
        android:textSize="21sp"
        android:textColor="@color/title_btn_text"
        android:background="@drawable/co_bt_title"
        android:minWidth="120dp"
        android:focusable="false"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_marginLeft="12dp"
        android:layout_width="wrap_content"
        android:layout_height="56dp" />
    <ImageButton
        android:id="@+id/row_x"
        android:background="@drawable/co_bt_title"
        android:scaleType="center"
        android:focusable="false"
        android:layout_marginLeft="8dp"
        android:layout_width="64dp"
        android:layout_height="56dp" />
</LinearLayout>
