[nemesis]
version=1.2
id=wireless.projection
name=Enable Wireless Features
type=application
package-version=2.0.0
short-desc="Enables built-in WiFi and OEM wireless Android Auto."
os=any
models=any
depends=usb-handler@>=1.17,!wireless.carplay.aa
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[patch.1]
target=/system/onebin/*/featurexml.cfg
engine=exec
tool=bin/lp-edit
args=featurexml
optional=1
stop=com.daudio.app.phoneprojection,com.daudio.app.dipo

[patch.2]
target=/system/etc/wifi/wpa_supplicant.conf
engine=exec
tool=bin/lp-edit
args=wpa
optional=1

[patch.3]
target=/system/etc/wifi/wpa_supplicant_overlay.conf
engine=exec
tool=bin/lp-edit
args=overlay
optional=1

[file.4]
target=/system/etc/permissions/android.hardware.wifi.xml
source=files/permissions/android.hardware.wifi.xml

[file.5]
target=/system/etc/permissions/com.hkmc.software.connectivity.androidauto_wireless.xml
source=files/permissions/com.hkmc.software.connectivity.androidauto_wireless.xml

[file.6]
target=/system/etc/permissions/com.hkmc.software.connectivity.carplay_wireless.xml
source=files/permissions/com.hkmc.software.connectivity.carplay_wireless.xml

[prop.1]
key=persist.ium.support
value=carplay

[prop.2]
key=persist.wifi.state
value=3
