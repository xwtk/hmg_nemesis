[nemesis]
version=1.2
id=projection.tbt
name=Projection cluster TBT
type=application
package-version=2.0.0
short-desc="Turn-by-turn on the cluster during projection."
os="*.260507"
models="any"
depends=usb-handler@>=1.17
preinstall=scripts/pre.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[patch.1]
target=/system/app/HKMC_GPM.odex
engine=exec
tool=bin/lp-pin
args=96cd7c27a9db19acb3900f21f57ea9f0 files/HKMC_GPM.apk

[patch.2]
target=/system/app/HKMC_DiPO.odex
engine=exec
tool=bin/lp-pin
args=a565e180fdb0b73d6520f28c91cdba63 files/HKMC_DiPO.apk
stop=com.daudio.app.dipo

[patch.3]
target=/system/app/Iap2ServerApp.odex
engine=exec
tool=bin/lp-pin
args=03950e4b691f846e5478a5a69818c65e files/Iap2ServerApp.apk
stop=com.tcc.iap2server

[patch.4]
target=/system/app/HKMC_Navi_ExSL.odex
engine=exec
tool=bin/lp-pin
args=9cf41f78ce312b3762b354714d12eec3 files/HKMC_Navi_ExSL.apk
stop=com.mnsoft.navi

[patch.5]
target=/system/lib/libautoreceiver_infobank.so
engine=exec
tool=bin/lp-pin
args=48ee793af8b86052503b8c952b034731 files/libautoreceiver_infobank.so
stop=com.daudio.app.dipo
